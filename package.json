{
  "name": "apache-spark-ct",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Apache Spark internals content repo for GraphL \u2014 'how it actually works' scenes (react-flow diagrams + IDE code cards) per slug, rendered full-frame for the compose pipeline. The render engine is the @graphlearning/flow package; the app shell is @graphlearning/shell. Syllabus: COURSE-PLAN.md.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && node scripts/lint-scenes.mjs",
    "preview": "vite preview",
    "build:snapshot": "vite build --outDir dist-snapshot",
    "capture": "vite preview --outDir dist-snapshot --port 5181",
    "capture:shots": "graphl-capture-shots",
    "record": "graphl-record",
    "record:reels": "graphl-record-reels",
    "shots:4k": "graphl-shots-4k",
    "gen:audio": "graphl-gen-audio",
    "gen:desc": "graphl-gen-desc",
    "thumb": "graphl-thumb",
    "lint:scenes": "node scripts/lint-scenes.mjs",
    "frames": "node scripts/frames.mjs"
  },
  "dependencies": {
    "@graphlearning/flow": "^0.8.0",
    "@graphlearning/shell": "^0.4.0",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
