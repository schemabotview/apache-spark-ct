{
  "name": "apache-spark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "GraphL concept app for Apache Spark: one PySpark pipeline built from an empty folder, one full-screen frame and one narration per section. The render engine is @graphlearning/flow; the app shell is @graphlearning/shell.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-content.mjs && node scripts/check-render.mjs",
    "preview": "vite preview",
    "build:snapshot": "vite build --outDir dist-snapshot",
    "capture": "vite preview --outDir dist-snapshot --port 5181",
    "capture:shots": "graphl-capture-shots",
    "record": "graphl-record",
    "record:all": "graphl-record-all",
    "record:reels": "graphl-record-reels",
    "shots:4k": "graphl-shots-4k",
    "gen:audio": "graphl-gen-audio",
    "gen:desc": "graphl-gen-desc",
    "thumb": "graphl-thumb",
    "check:spine": "python3 scripts/spine.py"
  },
  "dependencies": {
    "@graphlearning/flow": "^2.2.0",
    "@graphlearning/shell": "^0.14.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
